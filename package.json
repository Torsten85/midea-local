{
  "name": "midea-local",
  "version": "0.1.2",
  "description": "Local control of Midea smart air conditioners",
  "license": "MIT",
  "author": "Torsten Blindert",
  "repository": {
    "type": "git",
    "url": "https://github.com/Torsten85/midea-local.git"
  },
  "homepage": "https://github.com/Torsten85/midea-local",
  "bugs": "https://github.com/Torsten85/midea-local/issues",
  "keywords": ["midea", "air-conditioner", "smart-home", "local-control", "iot"],
  "engines": {
    "node": ">=18",
    "bun": ">=1.0"
  },
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build ./src/index.ts --outdir ./dist/esm --target node --splitting && bun build ./src/index.ts --outdir ./dist/cjs --target node --format cjs --external 'node:*' && mv ./dist/cjs/index.js ./dist/cjs/index.cjs && bunx tsc",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22",
    "typescript": "^5"
  }
}
